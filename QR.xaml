<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.QR"
             Title="" BackgroundColor="#526D82"
             xmlns:zxing ="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls">
    <Grid RowDefinitions="*,Auto"
		  ColumnDefinitions="*,*"
		  Padding="0">
        <Grid Grid.Row="0" Grid.Column="0"
			  HorizontalOptions="Center"
			  VerticalOptions="Center">
            <Image Source="zsme.png" Aspect="AspectFill"
				
				   WidthRequest="800"
				   HeightRequest="800"
				   HorizontalOptions="Center"
				   VerticalOptions="Center" 
               Opacity="0.5"/>
        </Grid>
        <VerticalStackLayout Grid.Row="0" Grid.Column="1"
							  VerticalOptions="Start"
							  HorizontalOptions="Center"
							  Spacing="10"
							  Margin="0,40,0,0">

            <VerticalStackLayout Grid.Row="0" Grid.Column="1"
                              VerticalOptions="Center"
                              HorizontalOptions="Center"
                              Spacing="45">

                <Label Text="ZESKANUJ KOD QR"
                   TextColor="White"
                   FontAttributes="Bold"
                   FontSize="42"
                   HorizontalTextAlignment="Center" />
                <Border Stroke="Transparent"
                        StrokeShape="RoundRectangle 25"
                        >
                    <zxing:CameraBarcodeReaderView
    WidthRequest="350"
    HeightRequest="350"
    
x:Name="cameraView"
BarcodesDetected="cameraView_BarcodesDetected"
IsTorchOn="False"
IsDetecting="True"/>
                </Border>


            </VerticalStackLayout>

        </VerticalStackLayout>
        <Grid Grid.Row="1" Grid.Column="1"
			  BackgroundColor="#3E5670"
			  HeightRequest="70"
			  ColumnDefinitions="*,*,*,*"
			  Padding="20,0">
            <ImageButton Grid.Column="0"
        Source="icon_home.png"
        BackgroundColor="Transparent"
        BorderWidth="0"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Clicked="OnHomeClicked"
             HeightRequest="10"/>


            <ImageButton Grid.Column="1"
        Source="icon_cal.png"
             HeightRequest="10"
        BackgroundColor="Transparent"
        BorderWidth="0"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Clicked="OnCalendarClicked"/>
            <ImageButton Grid.Column="2"
        Source="icon_qr.png"
             HeightRequest="10"
        BackgroundColor="Transparent"
        BorderWidth="0"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Clicked="OnQrClicked"/>
            <ImageButton Grid.Column="3"
        Source="icon_db.png"
             HeightRequest="10"
        BackgroundColor="Transparent"
        BorderWidth="0"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Clicked="OnDatabaseClicked"/>

        </Grid>

    </Grid>
</ContentPage>