<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.DB"
             Title="" BackgroundColor="#526D82">

    <Grid RowDefinitions="*,Auto"
          ColumnDefinitions="*,*"
          Padding="0">
        <Grid Grid.Row="0"
              Grid.Column="0"
              HorizontalOptions="Center"
              VerticalOptions="Center">

            <Image Source="zsme.png"
                   Aspect="AspectFill"
                   WidthRequest="800"
                   HeightRequest="800"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Opacity="0.5"/>
        </Grid>
        <Grid Grid.Row="0"
              Grid.Column="1"
              Padding="20,35,45,0">

            <ScrollView Grid.Row="0" Grid.Column="1">
                <VerticalStackLayout Spacing="0">

                    <Grid
            BackgroundColor="#526D82"
            HeightRequest="60"
            Padding="10,0"
            ColumnDefinitions="1.5*,1*,1.5*">

                        <Label
                Grid.Column="0"
                Text="MAIL"
                TextColor="White"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center"
                FontSize="16"/>

                        <Label
                Grid.Column="1"
                Text="NR TABLETU"
                TextColor="White"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center"
                FontSize="16"/>

                        <Label
                Grid.Column="2"
                Text="DATA"
                TextColor="White"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center"
                FontSize="16"/>

                    </Grid>
                    <VerticalStackLayout
            x:Name="DatabaseLayout"
            Spacing="0"/>

                </VerticalStackLayout>
            </ScrollView>

        </Grid>
        <Grid Grid.Row="1"
              Grid.Column="1"
              BackgroundColor="#3E5670"
              HeightRequest="70"
              ColumnDefinitions="*,*,*,*"
              Padding="20,0">
            <ImageButton Grid.Column="0"
        Source="icon_home.png"
        BackgroundColor="Transparent"
        BorderWidth="0"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Clicked="OnHomeClicked"
             HeightRequest="10"/>


            <ImageButton Grid.Column="1"
        Source="icon_cal.png"
             HeightRequest="10"
        BackgroundColor="Transparent"
        BorderWidth="0"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Clicked="OnCalendarClicked"/>
            <ImageButton Grid.Column="2"
        Source="icon_qr.png"
             HeightRequest="10"
        BackgroundColor="Transparent"
        BorderWidth="0"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Clicked="OnQrClicked"/>
            <ImageButton Grid.Column="3"
        Source="icon_db.png"
             HeightRequest="10"
        BackgroundColor="Transparent"
        BorderWidth="0"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Clicked="OnDatabaseClicked"/>

        </Grid>

    </Grid>

</ContentPage>