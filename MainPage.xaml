<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.MainPage" Title="" BackgroundColor="#526D82" Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="*,Auto"
			  ColumnDefinitions="*,*"
			  Padding="0">
        <Grid Grid.Row="0" Grid.Column="0"
				  HorizontalOptions="Center"
				  VerticalOptions="Center">
            <Image Source="zsme.png"
					   Aspect="AspectFit"
					   WidthRequest="800"
					   HeightRequest="800"
					   HorizontalOptions="Center"
					   VerticalOptions="Center" 
                   Opacity="0.5"/>
        </Grid>
        <VerticalStackLayout Grid.Row="0" Grid.Column="1"
								  VerticalOptions="Start"
								  HorizontalOptions="Center"
								  Spacing="10"
								  Margin="0,40,0,0">

            <Label Text="LICZBA DZISIEJSZYCH"
					   TextColor="White"
					   FontAttributes="Bold"
					   FontSize="42"
					   HorizontalTextAlignment="Center"
					   FontFamily="OpenSansSemibold" />

            <Label Text="LOGOWAŃ"
					   TextColor="White"
					   FontAttributes="Bold"
					   FontSize="42"
					   HorizontalTextAlignment="Center"
					   FontFamily="OpenSansSemibold" />

            <Label x:Name="TodayCount"
       Text="0"
       TextColor="White"
       FontAttributes="Bold"
       FontSize="64"
       HorizontalTextAlignment="Center"
       Margin="0,10,0,0" />

        </VerticalStackLayout>

        <Grid Grid.Row="1" Grid.Column="1"
				  BackgroundColor="#3E5670"
				  HeightRequest="70"
				  ColumnDefinitions="*,*,*,*"
				  Padding="20,0">

            <ImageButton Grid.Column="0"
        Source="icon_home.png"
        BackgroundColor="Transparent"
        BorderWidth="0"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Clicked="OnHomeClicked"
             HeightRequest="10"/>


            <ImageButton Grid.Column="1"
        Source="icon_cal.png"
             HeightRequest="10"
        BackgroundColor="Transparent"
        BorderWidth="0"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Clicked="OnCalendarClicked"/>
            <ImageButton Grid.Column="2"
        Source="icon_qr.png"
             HeightRequest="10"
        BackgroundColor="Transparent"
        BorderWidth="0"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Clicked="OnQrClicked"/>
            <ImageButton Grid.Column="3"
        Source="icon_db.png"
             HeightRequest="10"
        BackgroundColor="Transparent"
        BorderWidth="0"
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Clicked="OnDatabaseClicked"/>

        </Grid>

    </Grid>

</ContentPage>
